{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/configs/certify_v1.schema.json",
  "title": "certify job config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_hash", "n_tokens", "seq_len", "batch_size", "bands_version", "eval_slice"],
  "properties": {
    "checkpoint_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "n_tokens": { "type": "integer", "minimum": 1 },
    "seq_len": { "type": "integer", "minimum": 1 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "bands_version": { "type": "integer", "minimum": 1 },
    "eval_slice": {
      "description": "ED-5: text-level slice reference. method/params are optional when the checkpoint has a store with a recorded eval_holdout (auto-derived from A4); REQUIRED when the checkpoint is legacy (store_hash null) or its store predates eval_holdout -- enforced at runtime, not schema level, since it depends on registry contents.",
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_manifest_hash", "corpus_location"],
      "properties": {
        "corpus_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "corpus_location": { "type": "string", "pattern": "^(tamia|local|hf|wandb):.+$" },
        "method": { "enum": ["holdout_split", "stream_offset"] },
        "params": { "type": "object" }
      }
    },
    "report_card_dir": { "type": "string" }
  }
}
