{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/environment_acquisition_manifest/v1.schema.json",
  "title": "environment_acquisition_manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "schema_version",
    "source_hashes",
    "target",
    "generator",
    "tooling",
    "torch",
    "runtime",
    "derived_wheels"
  ],
  "properties": {
    "manifest_type": { "const": "environment_acquisition_manifest" },
    "schema_version": { "const": 1 },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pyproject", "uv_lock", "cluster_requirements"],
      "properties": {
        "pyproject": { "$ref": "#/$defs/source_file" },
        "uv_lock": { "$ref": "#/$defs/source_file" },
        "cluster_requirements": { "$ref": "#/$defs/source_file" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "abi"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "abi": { "type": "string", "minLength": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uv"],
      "properties": {
        "uv": { "type": "string", "minLength": 1 },
        "pip": { "type": ["string", "null"] },
        "virtualenv": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "hatchling": { "type": ["string", "null"] }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installers"],
      "properties": {
        "installers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "torch": { "$ref": "#/$defs/artifact" },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "derived_wheels": {
      "type": "array",
      "items": { "$ref": "#/$defs/derived_wheel" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "filename",
        "relative_path",
        "size_bytes",
        "origin",
        "sha256",
        "type"
      ],
      "properties": {
        "distribution": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "origin": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "type": { "enum": ["wheel", "sdist"] },
        "import_name": { "type": ["string", "null"] }
      }
    },
    "derived_wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "wheel",
        "source_sdist",
        "build_inputs",
        "builder",
        "frontend",
        "backend",
        "command"
      ],
      "properties": {
        "distribution": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "wheel": { "$ref": "#/$defs/artifact" },
        "source_sdist": { "$ref": "#/$defs/artifact" },
        "build_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture", "python", "abi"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 },
            "python": { "type": "string", "minLength": 1 },
            "abi": { "type": "string", "minLength": 1 }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
