{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/eval_compat_map/v1.schema.json",
  "title": "eval_compat_map v1 (A12) -- SS8-owned, edited only by hand",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "self_hash", "created_at", "created_by", "subject", "payload"],
  "properties": {
    "artifact_type": { "const": "eval_compat_map" },
    "schema_version": { "const": 1 },
    "self_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "code_commit", "entrypoint", "host"],
      "properties": {
        "run_id": { "type": "string" },
        "code_commit": { "type": "string" },
        "entrypoint": { "type": "string" },
        "host": { "type": "string" }
      }
    },
    "subject": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_hash", "location", "role"],
        "properties": {
          "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "location": { "type": "string", "pattern": "^(tamia|local|hf|wandb):.+$" },
          "role": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "judge_classes"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "judge_classes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class_id", "members"],
            "properties": {
              "class_id": { "type": "string" },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["judge_model", "rubric_version", "prompt_version"],
                  "properties": {
                    "judge_model": { "type": "string" },
                    "rubric_version": { "type": "string" },
                    "prompt_version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
