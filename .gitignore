# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so

# Environments
.env
.venv
env/
venv/

# Data & model weights (too large for git)
data/raw/*
!data/raw/.gitkeep
results/*
# Same dir/* + negation technique as the docs/reports/project_management
# block below, same reason: this one tree is bounded, sealed evidence
# (chain-of-custody manifests, inventories, adjudication READMEs, small
# logs/JSON) that must be versioned, not bulk experiment output.
!results/final_pairing/
*.pt
*.safetensors
*.bin
# ED-1 / §8.1: pinned test fixtures are the exception -- generated once and committed
!tests/fixtures/tiny_model/*.safetensors
!tests/fixtures/tiny_sae/*.safetensors

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# WandB
wandb/
*.wandb

# SLURM logs
slurm/logs/

# HuggingFace cache
hf_cache/

# Personal / local docs (not for public repo)
docs/archive/
.claude/
docs/*
reports/*
project_management/*

# ...EXCEPT governance artifacts, which must be versioned and searchable.
# These three trees are ignored under the R6-V5B precedent because they carry bulk
# run output (results JSON/JSONL/CSV/PNG, and run.json `command` fields that embed full
# argv). That precedent is about BULK OUTPUT, not about the prose that carries the claims —
# but the directory-level ignore swept both, and 18 governance artifacts sat untracked for
# weeks as a result, including VERIFICATION_LOG.md, every pre-registration, and PROJECT_STATE.md.
#
# Markdown only, so no bulk artifact is re-included by this. Note git cannot re-include a
# file whose PARENT DIRECTORY is excluded — hence `dir/*` above rather than `dir/`, which is
# the change that makes these negations work at all.
# Secret-scan before first tracking still applies; a negation permits tracking, it does not track.
!docs/*.md
!reports/*.md
!project_management/*.md

# Scratch probe output (repo-root scratch dirs from manual test runs)
tmp_r6c4_probe/

# Report output of scripts/recon_checkpoint_provenance.py (written next to
# the repo root every run; noticed while relocating the script, docs/
# repo_cleanup_plan.md Phase 5)
/provenance_recon_*.json

# Scratch from audit and preflight runs (docs/repo_cleanup_plan.md Phase 1)
.audit_extract_*/
.tmp_codex_preflight*/
.tmp_uv_cache/

# Repo-relative fallback for cache/output paths that must never default to
# a machine-specific absolute path (docs/repo_cleanup_plan.md Phase 3 P0,
# scripts/final_pairing/final_pairing_judge_cli.py's default_cache_path/
# default_output_root)
.local/

# OS
.DS_Store
*.swp
*.stackdump
