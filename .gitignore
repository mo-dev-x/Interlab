wandb/
*.wandb

# SLURM logs
slurm/logs/

# HuggingFace cache
hf_cache/

# Personal / local docs (not for public repo)
docs/archive/
.claude/
# Governance trees. Tracked by default -- exclude only the bulk/binary
# artifact types actually observed in them, not the whole tree. Replaces the
# former `docs/* / reports/* / project_management/* + !*.md` pattern, which
# hid 18 governance artifacts for weeks (including VERIFICATION_LOG.md, every
# pre-registration, and PROJECT_STATE.md): git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so `!dir/*.md` only reaches files directly in
# `dir/`, not nested subdirectories -- markdown one level deeper (e.g.
# project_management/SESSION_BOOTSTRAPS/*.md) stayed invisible too. And
# anything non-markdown (a JSON schema, a CSV, a diagram) vanished with no
# error, regardless of nesting.
# Secret-scan before first tracking still applies; an exclusion list controls
# what's tracked, it doesn't substitute for scanning it.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.pdf
docs/**/*.pptx
docs/**/*.csv
docs/**/*.jsonl
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.pdf
reports/**/*.pptx
reports/**/*.csv
reports/**/*.jsonl
project_management/**/*.png
project_management/**/*.jpg
project_management/**/*.jpeg
project_management/**/*.pdf
project_management/**/*.pptx
project_management/**/*.csv
project_management/**/*.jsonl

# Rendered exports of the internship report: an 8.6 MB PDF, and an HTML
# export whose own <link> tag embeds a machine-specific
# C:\Users\<name>\... path from the tool that generated it. Both are
# generated and machine-specific -- excluded rather than newly tracked by
# the inversion above. The embedded username path is the same class of
# defect as the P1 D:/devcache paths, found incidentally here, outside this
# pass's named scope -- flagged, not edited.
reports/internship_report.pdf
reports/internship_report.html

# Scratch probe output (repo-root scratch dirs from manual test runs)
tmp_r6c4_probe/

# Report output of scripts/recon_checkpoint_provenance.py (written next to
# the repo root every run; noticed while relocating the script, docs/
# repo_cleanup_plan.md Phase 5)
/provenance_recon_*.json

# Scratch from audit and preflight runs (docs/repo_cleanup_plan.md Phase 1)
.audit_extract_*/
.tmp_codex_preflight*/
.tmp_uv_cache/

# Repo-relative fallback for cache/output paths that must never default to
# a machine-specific absolute path (docs/repo_cleanup_plan.md Phase 3 P0,
# scripts/final_pairing/final_pairing_judge_cli.py's default_cache_path/
# default_output_root)
.local/

